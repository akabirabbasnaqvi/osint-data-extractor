# Copy this file to .env.production and replace every placeholder before deployment.
POSTGRES_DB=osint_db
POSTGRES_USER=osint_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://osint_user:replace-with-a-long-random-password@postgres:5432/osint_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
HUNTER_IO_API_KEY=
SEARXNG_URL=http://searxng:8080
HTTP_PROXY=
SECRET_KEY=replace-with-a-long-random-secret
# Used by the searxng container (overrides the placeholder key in searxng/settings.yml).
SEARXNG_SECRET=replace-with-another-long-random-secret
# Shared rate-limit counters across API workers.
RATE_LIMIT_STORAGE=redis://redis:6379/2
ALLOWED_ORIGINS=https://your-domain.example
NEXT_PUBLIC_API_URL=https://api.your-domain.example
