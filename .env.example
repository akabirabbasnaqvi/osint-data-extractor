# ============================================
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file (it's in .gitignore).
# ============================================

# --- Database ---
DATABASE_URL=postgresql://osint_user:osint_pass@postgres:5432/osint_db

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Free external APIs (fill in later, once you register for them) ---
HUNTER_IO_API_KEY=

# --- Discovery (self-hosted SearxNG, see docker-compose.yml) ---
# The default already matches the docker-compose service name/port —
# only change this if you rename that service.
SEARXNG_URL=http://searxng:8080

# --- Optional proxy (leave blank if not using Tor) ---
HTTP_PROXY=

# --- Security ---
SECRET_KEY=change_this_to_a_random_string
ALLOWED_ORIGINS=http://localhost:3000
